/******************************************************************************
 *  LAB 3 – STEP 1: Audio Loopback + Fs Measurement (Global Timer)
 ******************************************************************************/

#include <stdio.h>
#include "platform.h"
#include "xil_printf.h"
#include "xil_io.h"
#include "xiicps.h"
#include "timer_ps.h"
#include <math.h>

/* I2S Registers */
#define I2S_RESET_REG        0x00
#define I2S_CTRL_REG         0x04
#define I2S_CLK_CTRL_REG     0x08

#define FIFO_ISR             0x00
#define FIFO_TDFD            0x10
#define FIFO_TLR             0x14
#define FIFO_RDFO            0x1C
#define FIFO_RDFD            0x20

/* I2C Codec */
#define IIC_SLAVE_ADDR       0b0011010
#define IIC_SCLK_RATE        100000

/* Device IDs */
#define AUDIO_IIC_ID         XPAR_XIICPS_0_DEVICE_ID
#define AUDIO_CTRL_BASEADDR  XPAR_AXI_I2S_ADI_0_S00_AXI_BASEADDR
#define AUDIO_FIFO           XPAR_AXI_FIFO_MM_S_0_BASEADDR
#define FIR_FIFO             XPAR_AXI_FIFO_MM_S_1_BASEADDR
#define SCU_TIMER_ID         XPAR_SCUTIMER_DEVICE_ID

/* Global Timer */
#define GLOBAL_TMR_BASEADDR              XPAR_PS7_GLOBALTIMER_0_S_AXI_BASEADDR
#define GTIMER_COUNTER_LOWER_OFFSET      0x00
#define GTIMER_COUNTER_UPPER_OFFSET      0x04
#define GTIMER_CONTROL_OFFSET            0x08

XIicPs Iic;


/* ------------------- I2C Register Write ------------------- */
int AudioRegSet(XIicPs *IicPtr, u8 reg, u16 data)
{
    u8 buf[2];
    buf[0] = (reg << 1) | ((data >> 8) & 1);
    buf[1] = data & 0xFF;

    int Status = XIicPs_MasterSendPolled(IicPtr, buf, 2, IIC_SLAVE_ADDR);
    while (XIicPs_BusIsBusy(IicPtr)) {}
    return Status;
}


/* ------------------- Codec + I2S Init ------------------- */
int AudioInitialize()
{
    XIicPs_Config *Cfg = XIicPs_LookupConfig(AUDIO_IIC_ID);
    XIicPs_CfgInitialize(&Iic, Cfg, Cfg->BaseAddress);
    XIicPs_SetSClk(&Iic, IIC_SCLK_RATE);

    TimerInitialize(SCU_TIMER_ID);

    /* SSM2603 init */
    AudioRegSet(&Iic, 15, 0);
    TimerDelay(75000);
    AudioRegSet(&Iic, 6,  0b000110000);
    AudioRegSet(&Iic, 0,  0b000010111);
    AudioRegSet(&Iic, 1,  0b000010111);
    AudioRegSet(&Iic, 2,  0b101111001);
    AudioRegSet(&Iic, 4,  0b000010000);
    AudioRegSet(&Iic, 5,  0);
    AudioRegSet(&Iic, 7,  0b000001010);
    AudioRegSet(&Iic, 8,  0);
    TimerDelay(75000);
    AudioRegSet(&Iic, 9,  1);
    AudioRegSet(&Iic, 6,  0b000100000);

    /* I2S clock */
    u32 clkdiv = 1 | (31 << 16);
    Xil_Out32(AUDIO_CTRL_BASEADDR + I2S_CLK_CTRL_REG, clkdiv);

    /* Enable FIFOs */
    Xil_Out32(AUDIO_CTRL_BASEADDR + I2S_RESET_REG, 0b110);
    Xil_Out32(AUDIO_CTRL_BASEADDR + I2S_CTRL_REG,  0b011);

    return XST_SUCCESS;
}


/* ------------------- FIFO Read/Write ------------------- */
u32 I2SFifoRead(u32 fifo)
{
    while (Xil_In32(fifo + FIFO_RDFO) == 0) {}
    return Xil_In32(fifo + FIFO_RDFD);
}

void I2SFifoWrite(u32 fifo, u32 data)
{
    Xil_Out32(fifo + FIFO_TDFD, data);
    Xil_Out32(fifo + FIFO_TLR, 4);
    while ((Xil_In32(fifo + FIFO_ISR) & 0x08000000) == 0) {}
    Xil_Out32(fifo + FIFO_ISR, 0x08000000);
}


/* ------------------- FIFO Init ------------------- */
void initialize_FIFO(u32 addr)
{
    Xil_Out32(addr + FIFO_ISR, 0xFFFFFFFF);
}


/* ------------------- MAIN ------------------- */
int main()
{
    init_platform();

    xil_printf("=== LAB 3 – Step 1: Fs Measurement (Global Timer) ===\n\r");

    AudioInitialize();
    initialize_FIFO(AUDIO_FIFO);

    /* Enable Global Timer: bit0=enable, bit1=auto-inc */
    Xil_Out32(GLOBAL_TMR_BASEADDR + GTIMER_CONTROL_OFFSET, 0x03);

    u32 t0 = 0, t1 = 0;
    int j = 0;

    while (1)
    {
        /* Stereo sample */
        u32 L = I2SFifoRead(AUDIO_FIFO);
        u32 R = I2SFifoRead(AUDIO_FIFO);

        /* Global Timer measurement */
        if (j == 300)
            t0 = Xil_In32(GLOBAL_TMR_BASEADDR + GTIMER_COUNTER_LOWER_OFFSET);

        if (j == 301)
        {
            t1 = Xil_In32(GLOBAL_TMR_BASEADDR + GTIMER_COUNTER_LOWER_OFFSET);

            u32 delta = t1 - t0;
            float Fs = 333000000.0f / (float)delta;
            int Fs100 = (int)(Fs * 100);

            xil_printf("Δticks = %u   Fs ≈ %d.%02d Hz\n\r",
                       delta,
                       Fs100 / 100,
                       Fs100 % 100);

        }


        /* Loopback */
        I2SFifoWrite(AUDIO_FIFO, L);
        I2SFifoWrite(AUDIO_FIFO, R);

        if (j <= 301) j++;
    }

    cleanup_platform();
    return 0;
}
