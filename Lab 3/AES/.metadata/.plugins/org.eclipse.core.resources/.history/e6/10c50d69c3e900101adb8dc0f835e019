/**************************************************************
 * STEP 3 – Global Timer measurement for FIR execution time
 **************************************************************/

volatile int dummy = 0;  // prevents optimization
u64 t_start, t_end;
u32 k;

/* Deterministic input buffer for timing */
int test_buffer[N_HP];
for (k = 0; k < N_HP; k++)
    test_buffer[k] = (int)(k * 7);

/* Warm-up (cache/pipeline stabilization) */
for (k = 0; k < 200; k++)
    dummy = FIR_filter(test_buffer, HP, N_HP);

/* Real-time budget per sample in GlobalTimer ticks */
const double ticks_budget = (double)GTIMER_HZ / (double)FS_HZ;   // ≈ 6937 ticks/sample

xil_printf("\n=== FIR TIMING (CACHE ON) ===\n\r");

/* Measure */
t_start = read_global_timer_64();
for (k = 0; k < ITERATIONS; k++)
    dummy = FIR_filter(test_buffer, HP, N_HP);
t_end = read_global_timer_64();

u64 total_ticks_on = (t_end - t_start);
double ticks_per_call_on = (double)total_ticks_on / (double)ITERATIONS;
double ticks_per_tap_on  = ticks_per_call_on / (double)N_HP;
double max_taps_on       = ticks_budget / ticks_per_tap_on;

xil_printf("HP cache ON : total ticks = %llu  | ticks/call = %.2f\n\r",
           total_ticks_on, ticks_per_call_on);
xil_printf("Budget @ Fs=%.0f Hz: %.2f ticks/sample (GTIMER @ %.0f Hz)\n\r",
           (double)FS_HZ, ticks_budget, (double)GTIMER_HZ);
xil_printf("ticks/tap (cache ON) : %.2f\n\r", ticks_per_tap_on);
xil_printf("margin (cache ON)    : %.2f ticks\n\r", ticks_budget - ticks_per_call_on);
xil_printf("max taps (cache ON)  : %.0f\n\r", max_taps_on);


/**************************************************************
 * Cache OFF (worst-case-ish)
 **************************************************************/
Xil_DCacheDisable();
Xil_ICacheDisable();

/* Warm-up with caches OFF (optional but keeps symmetry) */
for (k = 0; k < 200; k++)
    dummy = FIR_filter(test_buffer, HP, N_HP);

xil_printf("\n=== FIR TIMING (CACHE OFF) ===\n\r");

t_start = read_global_timer_64();
for (k = 0; k < ITERATIONS; k++)
    dummy = FIR_filter(test_buffer, HP, N_HP);
t_end = read_global_timer_64();

u64 total_ticks_off = (t_end - t_start);
double ticks_per_call_off = (double)total_ticks_off / (double)ITERATIONS;
double ticks_per_tap_off  = ticks_per_call_off / (double)N_HP;
double max_taps_off       = ticks_budget / ticks_per_tap_off;

xil_printf("HP cache OFF: total ticks = %llu  | ticks/call = %.2f\n\r",
           total_ticks_off, ticks_per_call_off);
xil_printf("ticks/tap (cache OFF): %.2f\n\r", ticks_per_tap_off);
xil_printf("margin (cache OFF)   : %.2f ticks\n\r", ticks_budget - ticks_per_call_off);
xil_printf("max taps (cache OFF) : %.0f\n\r", max_taps_off);


/* Re-enable caches */
Xil_ICacheEnable();
Xil_DCacheEnable();

xil_printf("\nTIMING DONE – starting audio streaming...\n\r");

    /* -----------------------------------------------------------
     *   REAL-TIME STREAMING WITH SOFTWARE FIR (as in Step 2)
     * -----------------------------------------------------------
     */

    int SampleL, SampleR;


    /* Sliding-window buffers for FIR convolution.
     * Use the largest window size (N_HP) for both channels.
     */
    int bufferL[N_HP], bufferR[N_HP];

    /* Initialize convolution buffers to zero */
    for (int i = 0; i < N_HP; i++) {
        bufferL[i] = 0;
        bufferR[i] = 0;
    }

    while (1) {

        /* -------------------------------
         *  SAMPLE ACQUISITION (I²S RX)
         * ------------------------------- */
        /* -----------------------------
         *      SAMPLE ACQUISITION
         * -----------------------------
         * Read one stereo sample from the I²S RX FIFO.
         * Samples are 32-bit integers (packed audio data).
         */
        SampleL = (int) I2SFifoRead(AUDIO_FIFO);
        SampleR = (int) I2SFifoRead(AUDIO_FIFO);

        /* -------------------------------
         *  UPDATE SLIDING WINDOW
         * ------------------------------- */
        /* -----------------------------
         *     SLIDING WINDOW UPDATE
         * -----------------------------
         * Shift all older samples to the right:
         *
         *   buffer[k] ← buffer[k-1]
         *
         * Insert the newest sample at index 0.
         * This produces the structure:
         *   buffer[0] = x[n]
         *   buffer[1] = x[n-1]
         *   ...
         *   buffer[N_HP-1] = x[n-(N_HP-1)]
         */
        for (int i = N_HP - 1; i > 0; i--) {
            bufferL[i] = bufferL[i - 1];
            bufferR[i] = bufferR[i - 1];
        }
        bufferL[0] = SampleL;
        bufferR[0] = SampleR;

        /* -------------------------------
         *  FILTER SELECTION VIA SWITCHES
         * ------------------------------- */
        /* -----------------------------
         *       FILTER SELECTION
         * -----------------------------
         * Read switch inputs from the GPIO.
         *   SW0 → Low-Pass (base) filter
         *   SW1 → High-Pass (base) filter
         *   SW2 → Low-Pass (aggressive) filter
         *   SW3 → High-Pass (aggressive) filter
         *   none → raw passthrough
         */
        u32 sw = Xil_In32(SWI_BASE_ADDR);

        int outL, outR;

        if (sw & 0x1) {
            /* SW0 ON → Low-Pass filter */
            outL = FIR_filter(bufferL, LP, N_LP);
            outR = FIR_filter(bufferR, LP, N_LP);
        }
        else if (sw & 0x2) {
            /* SW1 ON → High-Pass filter */
            outL = FIR_filter(bufferL, HP, N_HP);
            outR = FIR_filter(bufferR, HP, N_HP);
        }
        else if (sw & 0x4) {
            // SW2 → Low-Pass (aggressive)
            outL = FIR_filter(bufferL, LP_AGG, N_LP_AGG);
            outR = FIR_filter(bufferR, LP_AGG, N_LP_AGG);
        }
        else if (sw & 0x8) {
            // SW3 → High-Pass (aggressive)
            outL = FIR_filter(bufferL, HP_AGG, N_HP_AGG);
            outR = FIR_filter(bufferR, HP_AGG, N_HP_AGG);
        }
        else {
            /* No filter selected → raw passthrough */
            outL = SampleL;
            outR = SampleR;
        }

        /* -------------------------------
         *  OUTPUT TO I²S TX
         * ------------------------------- */

        /* -----------------------------
         *          OUTPUT STAGE
         * -----------------------------
         * Send the processed (or raw) samples to the I²S TX FIFO
         * for playback through the audio DAC.
         */
        I2SFifoWrite(AUDIO_FIFO, outL);
        I2SFifoWrite(AUDIO_FIFO, outR);
    }

    cleanup_platform();
    return 0;
}
